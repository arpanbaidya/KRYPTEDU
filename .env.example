# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_id

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
SUPABASE_PROJECT_ID=your_project_id

# AI Provider Configuration (Server-side secret)
# Official supported provider: Google Gemini API (via @google/genai SDK)
# Supported models: gemini-3.8-flash, gemini-3.8-pro, gemini-2.5-flash
# If omitted or unconfigured, KRYPTEDU operates using its local deterministic analytics copilot & question bank.
AI_PROVIDER_API_KEY=your_ai_provider_api_key_here
AI_PROVIDER_MODEL=gemini-3.8-flash
# Alternative legacy environment variable aliases supported for backward compatibility:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Razorpay Payment Gateway Configuration (Server-side secrets)
# Provided by Razorpay Dashboard: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
